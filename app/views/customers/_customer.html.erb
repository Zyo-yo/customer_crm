<article class="customer-card">
  <h2><%= customer.full_name %></h2>

  <% if customer.image.attached? %>
    <%= image_tag customer.image,
                  alt: customer.full_name,
                  class: "customer-image" %>
  <% else %>
    <div class="customer-image customer-placeholder">No image</div>
  <% end %>

  <p><strong>Phone:</strong> <%= customer.phone_number.presence || "Not provided" %></p>
  <p><strong>Email:</strong> <%= customer.email_address.presence || "Not provided" %></p>
  <p><strong>Notes:</strong> <%= customer.notes.presence || "None" %></p>
</article>